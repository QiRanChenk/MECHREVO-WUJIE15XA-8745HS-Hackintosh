+// WUJIE: n-th AMD xHCI controller (class 0x0c0330, vendor 0x1022). Caller releases.
+static IOPCIDevice *wujieXhci(uint32_t idx){
+    OSDictionary *m = IOService::serviceMatching("IOPCIDevice");
+    if(!m) return nullptr;
+    OSIterator *it = IOService::getMatchingServices(m);
+    m->release();
+    if(!it) return nullptr;
+    IOPCIDevice *found = nullptr; uint32_t n = 0;
+    while(OSObject *o = it->getNextObject()){
+        IOPCIDevice *d = OSDynamicCast(IOPCIDevice, o);
+        if(!d) continue;
+        if(d->configRead16(kIOPCIConfigVendorID) != 0x1022) continue;
+        if((d->configRead32(kIOPCIConfigRevisionID) >> 8) != 0x0c0330) continue;
+        if(n++ == idx){ found = d; found->retain(); break; }
+    }
+    it->release();
+    return found;
+}
